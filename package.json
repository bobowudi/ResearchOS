{
  "name": "research-os",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace @research-os/web run dev",
    "dev:api": "npm --workspace @research-os/api run dev",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
